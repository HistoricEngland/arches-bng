recursive-include arches_bng
include README.md
include LICENSE
exclude manage.py
exclude arches_bng/settings_local.py
exclude .*
exclude *.yml
recursive-exclude .eggs *
recursive-exclude .github *
recursive-exclude .idea *
recursive-exclude node_modules *
recursive-exclude releases *
recursive-exclude tests *
recursive-exclude webpack *
recursive-exclude arches_bng/logs *
recursive-exclude arches_bng/staticfiles *
recursive-exclude arches_bng/uploadedfiles *
recursive-exclude arches_bng/media/build *
global-exclude *.log
global-exclude *.pyc
global-exclude *.zip
global-exclude *.DS_Store
global-exclude *.orig